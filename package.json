{
	"name": "culers",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "sh -c 'fuser -k 5175/tcp 2>/dev/null || true; vite'",
		"dev:keep": "vite",
		"build": "tsc -b && vite build",
		"sync:stadiums": "npx tsx scripts/sync-stadiums.ts",
