{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"functions": {
		"api/[...path].js": {
			"maxDuration": 60,
			"memory": 1024
		},
		"api/sofascore-fetch.py": {
			"maxDuration": 30,
			"memory": 1024,
			"excludeFiles": "{node_modules/**,dist/**,public/**,.venv-sofascore/**}"
		}
	}
}
